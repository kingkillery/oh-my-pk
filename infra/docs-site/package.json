{
  "name": "@oh-my-pk/docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/prepare.ts && astro build && bun scripts/assemble.ts",
    "test": "bun scripts/verify.ts && bun test ../install-redirect/worker.test.js",
    "check:worker": "wrangler deploy --dry-run --config ../install-redirect/wrangler.toml",
    "deploy": "wrangler deploy --config ../install-redirect/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.10",
    "astro": "7.2.10",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "wrangler": "4.159.0"
  }
}
