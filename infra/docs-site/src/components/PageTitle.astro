---
import Default from "@astrojs/starlight/components/PageTitle.astro";
const rawPath = Astro.locals.starlightRoute.entry.data.rawPath;
const markdownUrl = rawPath ? `/docs/raw/${rawPath.split("/").map(encodeURIComponent).join("/")}` : undefined;
---
{markdownUrl ? (
	<div id="_top" class="markdown-actions">
		<a href={markdownUrl}>View as Markdown</a>
		<button type="button" data-copy-markdown={markdownUrl} hidden>Copy Markdown</button>
		<span role="status" aria-live="polite" data-copy-status></span>
	</div>
) : <Default><slot /></Default>}
<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-markdown]")) {
		if (!navigator.clipboard?.writeText) continue;
		button.hidden = false;
		button.addEventListener("click", async () => {
			const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-status]");
			try {
				const response = await fetch(button.dataset.copyMarkdown!);
				if (!response.ok) throw new Error(`Markdown request failed: ${response.status}`);
				await navigator.clipboard.writeText(await response.text());
				if (status) status.textContent = "Markdown copied.";
			} catch {
				if (status) status.textContent = "Copy failed. Use View as Markdown instead.";
			}
		});
	}
</script>
<style>
	.markdown-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-block: 1rem; font-size: var(--sl-text-sm); }
	button { color: var(--sl-color-text-accent); background: transparent; border: 1px solid var(--sl-color-gray-5); border-radius: 0.35rem; padding: 0.3rem 0.6rem; cursor: pointer; }
	[role="status"] { color: var(--sl-color-gray-2); }
</style>
