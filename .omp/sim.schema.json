{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://oh-my-pk.local/schemas/sim.schema.json",
	"title": "Self-Improvement Memory (SIM) Ledger",
	"description": "Append-only problem/attempt ledger following arXiv:2611.18856 Appendix D.3 and OMPK-RSI §24.1 evidence integrity.",
	"type": "object",
	"additionalProperties": false,
	"required": ["next_id", "aliases", "problems"],
	"properties": {
		"$schema": {
			"type": "string",
			"minLength": 1
		},
		"schema_version": {
			"type": "integer",
			"enum": [1, 2]
		},
		"next_id": {
			"type": "integer",
			"minimum": 1
		},
		"carried_from": {
			"type": "object",
			"additionalProperties": false,
			"required": ["arm", "domain", "into"],
			"properties": {
				"arm": { "type": "string", "minLength": 1 },
				"domain": { "type": "string", "minLength": 1 },
				"into": { "type": "string", "minLength": 1 },
				"benchmark": { "type": "string", "minLength": 1 },
				"model": { "type": "string", "minLength": 1 },
				"carried_at": { "type": "string", "minLength": 1 }
			}
		},
		"aliases": {
			"type": "object",
			"propertyNames": {
				"pattern": "^P[1-9][0-9]*$"
			},
			"additionalProperties": {
				"type": "string",
				"pattern": "^P[1-9][0-9]*$"
			}
		},
		"problems": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/problem"
			}
		}
	},
	"$defs": {
		"problem": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "opened_round", "attempts"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^P[1-9][0-9]*$"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"opened_round": {
					"type": "integer",
					"minimum": 1
				},
				"attempts": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/attempt"
					}
				}
			}
		},
		"attempt": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"round",
				"accepted",
				"what",
				"files",
				"model",
				"domain",
				"benchmark",
				"predicted",
				"fixed",
				"missed",
				"regressed",
				"passed",
				"total"
			],
			"properties": {
				"round": { "type": "integer", "minimum": 1 },
				"accepted": { "const": true },
				"what": { "type": "string", "minLength": 1 },
				"files": {
					"type": "array",
					"minItems": 1,
					"items": { "type": "string", "minLength": 1 }
				},
				"model": { "type": "string", "minLength": 1 },
				"domain": { "type": "string", "minLength": 1 },
				"benchmark": { "type": "string", "minLength": 1 },
				"predicted": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"fixed": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"missed": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"regressed": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"preserved": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"unresolved": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"unproven": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"incomplete": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 },
					"uniqueItems": true
				},
				"passed": { "type": "integer", "minimum": 0 },
				"total": { "type": "integer", "minimum": 0 },
				"sample": { "type": "string", "minLength": 1 },
				"backfilled": { "type": "boolean" },
				"run": { "type": "string", "minLength": 1 },
				"baseline_ref": { "type": "string", "minLength": 1 },
				"candidate_ref": { "type": "string", "minLength": 1 },
				"commit": { "type": "string", "minLength": 1 },
				"timestamp": { "type": "string", "minLength": 1 }
			}
		}
	}
}
