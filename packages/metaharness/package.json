{
	"type": "module",
	"private": true,
	"name": "@pk-nerdsaver-ai/pi-metaharness",
	"version": "0.0.1",
	"description": "Unified benchmark runners plus Harbor run storage, REST/SSE APIs, and a live web dashboard",
	"homepage": "https://oh-my-pk.pkking.computer",
	"author": "Stencil Labs, Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingkillery/oh-my-pk.git",
		"directory": "packages/metaharness"
	},
	"bin": {
		"metaharness": "src/server.ts"
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit && tsgo -p src/tb/tsconfig.json --noEmit && tsgo -p adapters/edit/tsconfig.json --noEmit && tsgo -p scripts/tsconfig.json --noEmit",
		"lint": "biome lint .",
		"serve": "bun run src/server.ts",
		"bench:edit": "bun adapters/edit/cli.ts",
		"bench:tb": "bun src/tb/cli.ts",
		"bench:tb-floor": "bun scripts/tb-floor.ts",
		"dev": "bun --hot src/server.ts",
		"test": "bun test"
	},
	"dependencies": {
		"@pk-nerdsaver-ai/hashline": "catalog:",
		"@pk-nerdsaver-ai/pi-agent-core": "catalog:",
		"@pk-nerdsaver-ai/pi-ai": "catalog:",
		"@pk-nerdsaver-ai/pi-catalog": "catalog:",
		"@pk-nerdsaver-ai/pi-coding-agent": "catalog:",
		"@pk-nerdsaver-ai/pi-utils": "catalog:",
		"@pk-nerdsaver-ai/typescript-edit-benchmark": "workspace:*",
		"@stencil-hq/vibemon": "^0.3.2",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"diff": "catalog:",
		"@pk-nerdsaver-ai/pi-natives": "catalog:",
		"motion": "^12.15.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwind-merge": "^3.3.0"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"react-refresh": "^0.18.0"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
