{
	"name": "@pk-nerdsaver-ai/pi-chatgpt-connector",
	"version": "16.4.35",
	"description": "ChatGPT connector for oh-my-pk: a remote MCP server that launches and drives ompk tasks from ChatGPT, plus an ompk-side tool for delegating work to ChatGPT",
	"homepage": "https://github.com/kingkillery/oh-my-pk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingkillery/oh-my-pk.git",
		"directory": "packages/chatgpt-connector"
	},
	"bugs": {
		"url": "https://github.com/kingkillery/oh-my-pk/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"ompk-chatgpt": "./src/cli.ts"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./tool": {
			"types": "./src/chatgpt/tool.ts",
			"import": "./src/chatgpt/tool.ts"
		}
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@pk-nerdsaver-ai/pi-coding-agent": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"files": [
		"src",
		"README.md",
		"CHANGELOG.md"
	]
}
