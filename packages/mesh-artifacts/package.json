{
	"name": "@pk-nerdsaver-ai/mesh-artifacts",
	"version": "0.1.0",
	"description": "Content-addressed artifacts and manifest validation for LocalMesh",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"check": "biome check . && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "biome lint .",
		"test": "bun test --parallel"
	},
	"dependencies": {
		"@pk-nerdsaver-ai/mesh-contracts": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
